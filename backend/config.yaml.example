# OmniAgentAs-desk 配置文件模板
# 使用说明：
# 1. 复制此文件到 config/config.yaml
# 2. 填入您的API密钥
# 3. config.yaml 已被Git忽略，不会提交到仓库
#
# 编辑历史:
#   2026-09-21 - 小欧 - v4.20 键名按域收敛重排：app.debug/max_rounds/max_steps/project_root/allowed_dirs
#                       分域归 workspace/agent/logging；删白/黑名单4键与死配置（contentFilter/strict_mode/maxFileSize）；
#                       补行安全漏斗铁律注释
#   2026-09-21 - 小欧 - v4.20 单源收敛对齐：ai 顶层去扁平 provider/model，改结构化 ai.model_ref（唯一源，与真实 config.yaml 同构）
#   2026-09-22 - 小欧 - [61] 调优配置：新增 tuning 组 31 键（LLM/网络/并发/Agent/流任务/HITL/内容/网络）
#   2026-09-22 - 小欧 - [62]v1.4 模型枚举示例：zhipuai 下补 model_params/model_meta.param_options 完整写法（三层解析，按模型3/4/5个各配各的）
#   2026-09-23 - 小欧 - [64] LLM补充采样参数：新增顶层 llm 域（llm.sampling 5键 + llm.context_limit_default）
#   2026-09-23 - 小欧 - trim/compaction配置化：tuning组 Agent 循环参数后加 trim 3键/compaction 4键两独立分块；删 tuning.agent.default_max_steps 死键
#   2026-09-23 - 小欧 - 禁止backward还旧账：删 tuning.llm.temperature/max_tokens（已迁顶层 llm.sampling）+ 顶层 agent.max_rounds（已迁 tuning.trim.max_rounds）旧键残留
#   2026-09-23 - 小欧 - [65] 设置页「+添加参数」写入样子打样：zhipuai 段 model_params 补预设新键缀尾（temperature/top_p）+ 自定义键注释样例 + model_meta.range 捎带完整写法
#   2026-09-23 - 小欧 - 连接相关注释重写(北京老陈指令"一起补充"): provider timeout/max_retries 补优先级注释(高于tuning.llm_net/stream_max_retries) + tuning llm 3键/concurrency 2键/heartbeat/cors 全部改为「阶段+后果+分工」语义对齐 settings_registry notice - 小欧-2026-09-23
#   2026-09-23 - 小欧 - 调优组剩余注释全量重写(北京老陈指令"都是看的稀里糊涂 都优化一下"): llm 2键/trim 3键/compaction 4键/stream_task 3键/hitl 4键/content 3键 全部对齐 settings_registry notice 同口径「管什么+触发时机+后果+分工」 - 小欧-2026-09-23
#   2026-09-23 - 小欧 - 调优组注释去开发术语(北京老陈指令"怎么还有开发的代码信息"): 删 SSE/HITL/bypass/CORS/Origin/chunk/FC/C4/TTL/信号量/request body/ConnectTimeout 等代码黑话，全部改纯用户语言，与 registry notice 同步 - 小欧-2026-09-23
#   2026-09-24 21:36:38 - 小欧 - 组名改 tuning.stream_task→tuning.live_front(北京老陈裁定"live_front 更准确"，原名与 tuning.llm.stream_* 易混且非 LLM body 流式)；块下 4 键路径/值/注释措辞不变，仅块名改 — 小欧-2026-09-24
#
# ⚠️ 严禁事项（铁律）— 小欧 2026-09-21
#   ❌ 禁止新增任何 openai / gpt 相关 provider 或模型（如 openai、gpt-4、gpt-3.5）
#   ❌ 禁止复制网上模板带入 openai/gpt 垃圾配置（占位 api_key=sk-new-key 之类一律不准出现）
#     命令安全由 path_safe_check/tools/security 代码内实现（路径校验才是关键）

ai:
  # ✅ 顶层配置（全局）— 唯一源 ai.model_ref（v4.20 单源收敛，删扁平 provider/model）
  model_ref: {provider: opencode, model: kimi-k2.5-free}

  # ✅ Provider配置（多个）
  # timeout=max_retries 优先级高于全局 tuning.llm_net.read_timeout / tuning.llm.stream_max_retries — 小欧-2026-09-23
  opencode:
    api_base: https://opencode.ai/zen/v1
    api_key: sk_xxx...
    models:
      - minimax-m2.5-free
      - kimi-k2.5-free
    timeout: 120                 # Provider级读超时(秒)：优先于 tuning.llm_net.read_timeout(150)，未配则用全局

  longcat:
    api_base: https://api.longcat.chat/v1
    api_key: ak_xxx...
    models:
      - LongCat-Flash-Thinking
    timeout: 120                 # Provider级读超时(秒)：优先于 tuning.llm_net.read_timeout(150)，未配则用全局

  zhipuai:
    api_base: https://test.com
    api_key: test123
    max_retries: 3               # Provider级流式最大重试：优先于 tuning.llm.stream_max_retries(3)，未配则用全局
    models:
      - glm-4.7-flash
      - cogview-3-flash
    timeout: 90                  # Provider级读超时(秒)：优先于 tuning.llm_net.read_timeout(150)，未配则用全局
    # 模型参数当前值（运行时透传 extra_body/context_limit）— 小欧 2026-09-22
    # key=参数名，value=当前值（字符串保持字符串，如 reasoning_effort: medium）
    model_params:
      glm-4.7-flash:
        reasoning_effort: medium
        # ↓ 设置页「+ 添加参数」勾选预设后保存写入的样子：新键缀尾 — 小欧 2026-09-23 [65]
        temperature: 0.7
        top_p: 1.0
        # my_custom_key: 1.0  # 自定义参数同理缀尾；无 range/options 时只进 model_params，不写 model_meta
    # 模型元数据：枚举选项 SSOT（按模型各配各的）— 小欧 2026-09-22
    # 三层解析：model_meta.param_options（本级最高）> provider级 param_options > 代码兜底
    # 不写 model_meta 的模型走兜底 [low, medium, high]；3/4/5个选项各写各的单子
    model_meta:
      glm-4.7-flash: # 3个选项
        param_options:
          reasoning_effort: [low, medium, high]
        # ↓ 带 range 的预设保存时捎带全量 range 表（[65]§4.2.4 新键时全量捎带）— 小欧 2026-09-23
        range:
          temperature:
            min: 0
            max: 2
          top_p:
            min: 0
            max: 1
      # cogview-3-flash: # 4个选项示例（按需解开）
      #   param_options:
      #     reasoning_effort: [low, medium, high, xhigh]
      # new-big-model: # 5个选项示例（按需解开）
      #   param_options:
      #     reasoning_effort: [low, medium, high, xhigh, ultra]

# 外观配置（app 保留块；language/theme 暂留本块，深色主题二期再归 appearance）
app:
  language: zh-CN
  theme: light

# 工作区配置（项目根=tool工作区; 未配置(空)时兜底=用户主目录 — 小欧 2026-08-10 ①）
workspace:
  project_root: ""  # 项目根=tool工作区; 未配置(空)时兜底=用户主目录 — 小欧 2026-08-10 ①
  # 授权目录列表(可多个): tool 在项目根之外额外授权访问的工作目录。
  # 格式: YAML 列表, 每行一个绝对路径, 以 "- " 开头(不是逗号/分号分隔字符串), 例如:
  #   allowed_dirs:
  #     - D:\工作目录A
  #     - D:\工作目录B
  # 注意: 项目根天然在授权内, 无需重复列入; 指向代码库根或其父/子级 → 加载即拒(与⑦tool禁区冲突) — 小欧 2026-08-10 ⑩
  allowed_dirs: []

# Agent 循环配置
agent:
  max_steps: 10000

# 日志配置
logging:
  debug: true                # 调试模式: true→backend/files、DEBUG日志; false→用户级持久
  level: INFO                # DEBUG, INFO, WARNING, ERROR
  max_file_size: 10485760    # 单日志文件大小上限（字节）
  backup_count: 5            # 轮转保留文件数

# 安全配置
# 2026-09-03 小欧: auto_confirm_delay(bypass自动确认S1窗口,默认10) 与 hitl_timeout(真HITL确认超时,默认120)
security:
  enabled: false
  confirmDangerousOps: true
  auto_confirm_delay: 10
  hitl_timeout: 120

# 沙箱预检配置节（2026-08-25 小欧；total开关逃生门）
sandbox:
  enabled: true                    # 总开关(逃生门): false=完全关闭预检, 行为与实施前一致
  backend: "job_object"            # 后端选择键(预留扩展位): 当前唯一实现 job_object
  max_concurrent_sandboxes: 3      # 并发预检信号量上限(防N×内存上限叠加)
  max_workspace_mb: 500            # 工作区大小上限; 超限拒绝预检转HITL强确认
  max_shadow_mb: 100               # 影子副本单文件上限; 超限跳过副本仅统计影响面
  process_memory_limit_mb: 2048    # Job Object 进程树内存上限(误杀时调大此值)
  default_timeout_sec: 60          # 预检默认超时(LLM未声明timeout时生效)
  max_timeout_sec: 300             # 预检硬上限5分钟; 声明超上限直接转HITL强确认

# ============ 顶层 llm 域（模型无关通用，UI=设置→通用） ============
llm:
  sampling:                   # A类 采样/生成控制（5 键）
    temperature: 0.7          # 采样温度：0=完全确定性，1=默认随机性，2=最高随机性
    max_tokens: 16384         # 单次 LLM 调用最大输出 token 数，超长截断
    top_p: 1.0                # 核采样阈值：从概率质量前 p 的词中采样；1.0=不筛选
    frequency_penalty: 0      # 正值减少重复词频（更多样），负值增加重复词频（更聚焦），0=不启用
    presence_penalty: 0       # 正值惩罚已出现过的词（鼓励新话题），负值鼓励重复已出现的词，0=不启用
  context_limit_default: 262144   # C类全局兜底（256K）：值域 200000~2000000

# 调优配置（前端「调优」Tab 展示；9子组33键，network 已迁顶层）— 小欧-2026-09-23
tuning:
  # LLM 语义参数（5 键）— 注释 2026-09-23 去开发术语重写，对齐 registry notice — 小欧-2026-09-23
  llm:
    tool_choice: auto              # auto=正常调工具; none=禁用工具只回文字(排查工具问题用)
    stream_max_retries: 3          # 断线/超时自动重发最多再试N次;0=不重试。与下面分工:本管没收到,下面管内容坏
    response_fallback: true        # 工具一直失败重试用完后,自动改成不调工具直接写文字再试;关=直接报错
    response_retries: 2            # 空回复/坏内容自动重试最多N次;配额完/限流/请求写错不走这里
    stream_options:
      include_usage: true          # 回答结束附带本次token消耗;关则统计页显示0

  # LLM 网络/超时/连接池（7 键）— 注释 2026-09-23 去开发术语重写 — 小欧-2026-09-23
  llm_net:
    read_timeout: 150              # 两次收到回字最大间隔(非总时长):超时判连接断。与总时长分工:本管间隔
    connect_timeout: 30.0          # 连上模型服务器最大等待:连不上/DNS失败超时报错
    write_timeout: 10.0            # 把问题发出去的最大等待:请求大/上行慢时用到
    pool_timeout: 10.0             # 连接用满时等空位最久多久:等到接着发,等不到报错
    max_connections: 10            # 同时最多几条请求:超出排队(排多久看pool_timeout)
    max_keepalive: 5               # 空闲保留连接条数供复用;0=用完即断
    stream_total_timeout: 500      # 单次回答从头到尾总时长上限,到点强制掐断(与间隔超时分工:本管总长)

  # 并发配额（2 键）— 注释 2026-09-23 去开发术语重写 — 小欧-2026-09-23
  concurrency:
    soft_pool_wait_timeout: 30.0   # 排队最多等N秒,超时不排了照样放行(防任务卡死)
    shell_pool_max_per_type: 8     # 同任务同种终端最多开几个常驻会话,满了要等

  # Agent 循环参数（1 键）— 注释 2026-09-23 去开发术语重写 — 小欧-2026-09-23
  agent:
    max_chunks_without_promote: 50 # 一直吐零碎字却不给完整回答,累计N次判卡死强制结束(防白烧配额)

  # 裁剪（3 键，每轮循环自动执行）— 注释 2026-09-23 去开发术语重写 — 小欧-2026-09-23
  trim:
    max_rounds: 100                # 只记得最近N轮问答,更早自动忘;大=记得久费token,小=省钱忘得快
    trigger_ratio: 0.75            # 对话占记忆容量75%时开始删旧;小=删得勤,大=多记会
    compaction_buffer: 20000       # 删旧时故意留这么多容量给本次回答,防删完没地方写

  # 压缩（4 键，开局超容时压成摘要）— 注释 2026-09-23 去开发术语重写 — 小欧-2026-09-23
  compaction:
    start_enabled: true            # 开局旧对话太长时先压成摘要再干活;关=不压直接硬删
    start_trigger_ratio: 0.5       # 开局旧对话占容量一半才值得压;只管开局这一次
    summary_feed_max_chars: 2000   # 压摘要前单条工具结果超N字先砍;防超长撑爆
    keep_tail: 1                   # 压完摘要再原样留最近几条;0=全压不留原话

  # 连接保活/任务清理/缓存（4 键）— 注释 2026-09-23 去开发术语重写 — 小欧-2026-09-23
  # 组名 stream_task→live_front — 小欧-2026-09-24
  live_front:
    heartbeat_interval: 25.0       # 没新内容时隔N秒发"我还活着"防页面误判断线;须明显小于60秒断线判定
    task_timeout_hours: 1          # 做完的任务保留N小时后自动清出列表(在跑的不受影响)
    tool_cache_ttl: 300            # 同工具同参数N秒内直接给上次结果不重跑;小=新鲜慢,大=快但可能过期
    max_cache_size: 1000           # 内部小缓存最多存多少条,超了丢最久没用的;一般不用动

  # 人工确认（4 键）— 注释 2026-09-23 去开发术语重写 — 小欧-2026-09-23
  hitl:
    hitl_confirm_lead: 10          # 确认弹窗倒计时比后端实际超时提前N秒归零,先看到提示不凭空消失
    bypass_auto_lead: 2            # 自动放行弹窗倒计时提前N秒归零,页面先收好后端再放行
    hitl_min_confirm_timeout: 3    # 倒计时至少显示N秒,防弹窗一闪来不及点
    max_pending_confirmations: 100 # 同时排队等确认最多N条,超了新的直接拒(防弹窗洪水)

  # 内容截断（3 键）— 注释 2026-09-23 去开发术语重写 — 小欧-2026-09-23
  content:
    project_context_max_chars: 10000  # 项目规则文件每次带给模型最多N字,超长不带
    action_log_result_max_chars: 5000 # 工具结果写进对话最多留N字,超长截断(防大文件撑爆)
    temp_history_char_limit: 50000    # 压缩时临时副本最多N字,超了硬截断(防爆保险)

# 网络（1 键，顶层 network 域，系统组显示）— 小欧-2026-09-23 键名去 tuning 前缀
network:
  cors_origins: "http://localhost:5173,http://127.0.0.1:5173"  # 允许访问的页面地址白名单,换端口要加新地址
