# 外观配置（app 保留块；language/theme 暂留本块，深色主题二期再归 appearance）
app:
  language: zh-CN
  theme: light

# 媒体附件配置 — 图片走哪条通道由实测能力定，本块只管上限/压缩/外链开关 — 小欧-2026-11-08
#   inline_limit_mb: 内联上限(MB)。超过先压缩；压缩后仍超或关掉压缩 → 退化为一行文字说明
#   compress_max_edge / compress_jpeg_quality: 压缩只缩不改内容(长边像素、JPEG 质量)
#   remote_url_passthrough: 实测支持外链的模型，把它在消息里显式给出的公网图片链接直接转发(零字节搬运)
#   probe_image_url: 「传输探测」测外链腿用的公网位图地址(设置页② Image_URL 行就地显示/修改)；留空=只测内联
#     默认取 PNG 而非 ico: 实测 sensenova 对 .ico 返 400 image download failed, agnes 可拉 — 小欧-2026-11-09
media:
  inline_limit_mb: 2
  compress_enabled: true
  compress_max_edge: 2048
  compress_jpeg_quality: 85
  remote_url_passthrough: true
  probe_image_url: "https://www.baidu.com/img/flexible/logo/pc/result.png"

# 前端(step)渲染显示配置 — 小欧 2026-10-05 定两个独立开关，默认皆开
#   step_render.thoughtMarkdown = 「思考排版」: thought 块正文是否按 Markdown 语法渲染
#       (标题/粗体/列表/代码; 关掉则按纯文本实时显示)
#   step_render.reasoningVisible = 「推理内容」: reasoning 块每段的折叠初值
#       (开=每段进来就展开; 关=每段进来只留标题行, 点标题行的箭头可单独展开/收起)
#   step_render.contentRender = 「Content渲染」: 步骤内容(content)渲染开关
#       (开=正常渲染步骤内容; 关=隐藏步骤内容)
#   step_render.diffRender = 「Diff渲染」: Diff渲染开关
#       (开=显示代码变更对比; 关=隐藏Diff视图)
# 四个开关互不干涉: 各自控制独立渲染维度 — 小欧-2026-10-26
appearance:
  step_render:
    thoughtMarkdown: true
    reasoningVisible: true
    contentRender: true
    diffRender: true

# 工作区配置（项目根=tool工作区; 未配置(空)时缺省=用户主目录 — 小欧 2026-08-10）
workspace:
  project_root: ""  # 项目根=tool工作区; 未配置(空)时兜底=用户主目录 — 小欧 2026-08-10 ①
  # 授权目录列表(可多个): tool 在项目根之外额外授权访问的工作目录。
  # 格式: YAML 列表, 每行一个绝对路径, 以 "- " 开头(不是逗号/分号分隔字符串), 例如:
  #   allowed_dirs:
  #     - D:\工作目录A
  #     - D:\工作目录B
  # 注意: 项目根天然在授权内, 无需重复列入; 指向代码库根或其父/子级 → 加载即拒(与 tool 禁区冲突) — 小欧 2026-08-10
  allowed_dirs: []

# Agent 循环配置
agent:
  max_steps: 10000

# 日志配置
logging:
  debug: true                # 调试模式(全局开关): true→日志强制DEBUG+调试接口开放+文件落backend/files; false→按level阈值
  level: WARNING             # 日志级别(单键两用法): 控制台只显示「== 该级别」的行, 日志文件按常规阈值记「>= 该级别」; 调debug=true时文件强制DEBUG(控制台不受影响) — 2026-11-03 小欧
  max_file_size: 10485760    # 单日志文件大小上限（字节）
  backup_count: 5            # 轮转保留文件数

# 安全配置
# 2026-10-03 小欧: auto_confirm_delay(bypass自动确认S1窗口,默认10) 与 hitl_timeout(真HITL确认超时,默认120)
# 2026-10-18 小欧 - 开关键名随子命名空间跟定: security.enabled → security.hitl.enabled。
#   该项只决定是否弹窗请用户确认(人工确认链路);
#   危险防护(磁盘根/项目根/系统目录删除硬底线、系统保护进程、危险命令)无条件生效, 不受本项影响。
security:
  system:
    confirm_dangerous_ops: true      # 仅 UX 层: 保存设置时再多问一次(防误触), 与后端拦截无关
  hitl:
    enabled: true                     # true=高危操作弹窗请用户确认; false=免确认自动放行(危险防护仍生效)
    auto_confirm_delay: 10            # 自动确认弹窗倒计时(秒), 到时没人点就自动放行
    timeout: 120                      # 人工确认弹窗最长等待(秒), 超时按弹窗设定处理方式收尾
    shell_readonly_prefixes: ""    # 留空=用内置只读免确认名单; 填则覆盖(每行或逗号分隔)
  trust:
    ttl_days: 90          # 会话信任("信任此操作")的有效天数, 到期自动失效
  # shell_readonly_prefixes 刻意**不写进模板**: 键一旦存在(哪怕值为空), 设置页就会显示该原始值
  # 而非内置默认 → 用户看到空框, 反而"看不见"这份免确认清单。要改请在设置页「安全」组改,
  # 或手写该键(逗号/换行分隔一个前缀); 留空/缺键一律回退内置 30 条默认清单。

# 沙箱预检配置节（2026-08-25 小欧；total开关逃生门）
sandbox:
  enabled: true                    # 总开关(逃生门): false=完全关闭预检, 行为与实施前一致
  backend: "job_object"            # 后端选择键(预留扩展位): 当前唯一实现 job_object
  max_concurrent_sandboxes: 3      # 并发预检信号量上限(防N×内存上限叠加)
  max_workspace_mb: 500            # 工作区大小上限; 超限拒绝预检转HITL强确认
  max_shadow_mb: 100               # 影子副本单文件上限; 超限跳过副本仅统计影响面
  process_memory_limit_mb: 2048    # Job Object 进程树内存上限(误杀时调大此值)
  default_timeout_sec: 60          # 预检默认超时(LLM未声明timeout时生效)
  max_timeout_sec: 300             # 预检硬上限5分钟; 声明超上限直接转HITL强确认

# ============ 顶层 llm 域（模型无关通用，UI=设置→通用） ============
llm:
  sampling:                   # A类 采样/生成控制（5 键）
    temperature: 0.7          # 采样温度：0=完全确定性，1=默认随机性，2=最高随机性
    max_tokens: 16384         # 单次 LLM 调用最大输出 token 数，超长截断
    top_p: 1.0                # 核采样阈值：从概率质量前 p 的词中采样；1.0=不筛选
    frequency_penalty: 0      # 正值减少重复词频（更多样），负值增加重复词频（更聚焦），0=不启用
    presence_penalty: 0       # 正值惩罚已出现过的词（鼓励新话题），负值鼓励重复已出现的词，0=不启用
    reasoning_effort: low     # 全局推理深度默认值，只列所有推理模型都支持的三个核心值(low/medium/high).默认low
  context_length_default: 262144   # C类全局兜底（256K）：值域 200000~2000000

# 调优配置（前端「调优」Tab 展示；9子组33键，network 已迁顶层）— 小欧-2026-09-23
tuning:
  # LLM 语义参数（5 键）— 注释 2026-09-23 去开发术语重写，对齐 registry notice — 小欧-2026-09-23
  llm:
    tool_choice: auto              # auto=正常调工具; none=禁用工具只回文字(排查工具问题用)
    stream_max_retries: 3          # 断线/超时自动重发最多再试N次;0=不重试。与下面分工:本管没收到,下面管内容坏
    response_fallback: true        # 工具一直失败重试用完后,自动改成不调工具直接写文字再试;关=直接报错
    response_retries: 2            # 空回复/坏内容自动重试最多N次;配额完/限流/请求写错不走这里
    stream_options:
      include_usage: true          # 回答结束附带本次token消耗;关则统计页显示0

  # LLM 网络/超时/连接池（7 键）— 注释 2026-09-23 去开发术语重写 — 小欧-2026-09-23
  llm_net:
    read_timeout: 150              # 两次收到回字最大间隔(非总时长):超时判连接断。与总时长分工:本管间隔
    connect_timeout: 30.0          # 连上模型服务器最大等待:连不上/DNS失败超时报错
    write_timeout: 10.0            # 把问题发出去的最大等待:请求大/上行慢时用到
    pool_timeout: 10.0             # 连接用满时等空位最久多久:等到接着发,等不到报错
    max_connections: 10            # 同时最多几条请求:超出排队(排多久看pool_timeout)
    max_keepalive: 5               # 空闲保留连接条数供复用;0=用完即断
    stream_total_timeout: 500      # 单次回答从头到尾总时长上限,到点强制掐断(与间隔超时分工:本管总长)

  # 并发配额（2 键）— 注释 2026-09-23 去开发术语重写 — 小欧-2026-09-23
  concurrency:
    soft_pool_wait_timeout: 30.0   # 排队最多等N秒,超时不排了照样放行(防任务卡死)
    shell_max_processes: 10        # 同时执行的shell子进程总数上限(每个约40MB),跑完即销毁不常驻 — 小欧-2026-11-06

  # Agent 循环参数（2 键）— 注释 2026-09-23 去开发术语重写 — 小欧-2026-09-23
  agent:
    max_chunks_without_promote: 50 # 一直吐零碎字却不给完整回答,累计N次判卡死强制结束(防白烧配额)
    disabled_tools: "question, skill, subagent, patch, execute"  # 禁用工具名单: 模型调用时提示「禁止使用」并点明全组(防反复试错); 不影响已注册正常工具; 清空=不禁用任何工具 — 小欧-2026-11-10

  # 裁剪（3 键，每轮循环自动执行）— 注释 2026-09-23 去开发术语重写 — 小欧-2026-09-23
  # 裁剪（5 键，loop 每轮评估）— 小欧-2026-10-25
  trim:
    max_rounds: 100                # 历史轮数上限, 超出即触发裁剪
    trigger_ratio: 0.8             # 裁剪入口阈值=budget_base×系数(一次方); 裁剪出口队列预算=budget_base×系数²(二次方); 预算=window-compaction_buffer-tools_token_reserve
    compaction_buffer: 20000       # 增量触发阈值, 亦从裁剪预算中扣除
    keep_recent_rounds: 5          # 裁剪时最近 N 个 FC 工具步不参与裁剪, 范围 5-20
    tools_token_reserve: 30000     # tools schema 占用输入 token, 从裁剪预算扣除防超窗 400

  # 压缩（4 键，开局超容时压成摘要）— 注释 2026-09-23 去开发术语重写 — 小欧-2026-09-23
  compaction:
    start_enabled: true            # 开局旧对话太长时先压成摘要再干活;关=不压直接硬删
    start_limit_ratio: 0.5         # 压缩摘要限制系数(0.5=占容量一半就压);只管开局这一次
    summary_feed_max_chars: 2000   # 压摘要前单条工具结果超N字先砍;防超长撑爆
    keep_tail: 1                   # 压完摘要再原样留最近几条;0=全压不留原话

  # 连接保活/任务清理/缓存/事件流水保留（5 键）— 注释 2026-09-23 去开发术语重写 — 小欧-2026-09-23
  # 组名 stream_task→live_front — 小欧-2026-09-24
  live_front:
    heartbeat_interval: 25.0       # 没新内容时隔N秒发"我还活着"防页面误判断线;须明显小于60秒断线判定
    task_timeout_hours: 1          # 做完的任务保留N小时后自动清出列表(在跑的不受影响)
    tool_cache_ttl: 300            # 同工具同参数N秒内直接给上次结果不重跑;小=新鲜慢,大=快但可能过期
    max_cache_size: 1000           # 内部小缓存最多存多少条,超了丢最久没用的;一般不用动
    journal_retention_days: 7      # 事件流水保留N天;只清已终态任务,在跑的任务永不删 — 小欧-2026-09-29

  # 人工确认（4 键）— 注释 2026-09-23 去开发术语重写 — 小欧-2026-09-23
  hitl:
    hitl_confirm_lead: 10          # 确认弹窗倒计时比后端实际超时提前N秒归零,先看到提示不凭空消失
    bypass_auto_lead: 2            # 自动放行弹窗倒计时提前N秒归零,页面先收好后端再放行
    hitl_min_confirm_timeout: 3    # 倒计时至少显示N秒,防弹窗一闪来不及点
    max_pending_confirmations: 100 # 同时排队等确认最多N条,超了新的直接拒(防弹窗洪水)

  # 内容截断（3 键）— 注释 2026-09-23 去开发术语重写 — 小欧-2026-09-23
  content:
    project_context_max_chars: 10000  # 项目规则文件每次带给模型最多N字,超长不带
    action_log_result_max_chars: 5000 # 工具结果写进对话最多留N字,超长截断(防大文件撑爆)
    temp_history_char_limit: 50000    # 压缩时临时副本最多N字,超了硬截断(防爆保险)

# 网络（1 键，顶层 network 域，系统组显示）— 小欧-2026-09-23 键名去 tuning 前缀
network:
  cors_origins: "http://localhost:2000,http://127.0.0.1:2000"  # 仅跨域部署时生效; 打包版同源运行无需配置

# 系统：对话历史保留（设置页 系统 tab）— 小欧-2026-11-03
system:
  chat_retention_days: 0         # 对话历史保留N天;0=关闭(默认,不删用户历史),>0 启动时清理超期会话(级联tasks/steps/events)
