# OmniAgentAs-desk 配置文件模板
# 使用说明：
# 1. 复制此文件到 config/config.yaml
# 2. 填入您的API密钥
# 3. config.yaml 已被Git忽略，不会提交到仓库
#
# 编辑历史:
#   2026-09-21 - 小欧 - 键名按域收敛重排：app.debug/max_rounds/max_steps/project_root/allowed_dirs
#                       分域归 workspace/agent/logging；删白/黑名单4键与死配置（contentFilter/strict_mode/maxFileSize）；
#                       补行安全漏斗说明注释
#   2026-09-21 - 小欧 - 单源收敛对齐：ai 顶层去扁平 provider/model，改结构化 ai.model_ref（唯一源，与真实 config.yaml 同构）
#   2026-09-22 - 小欧 - 调优配置：新增 tuning 组 31 键（LLM/网络/并发/Agent/流任务/HITL/内容/网络）
#   2026-09-22 - 小欧 - 模型枚举示例：zhipuai 下补 model_params/model_meta.param_options 完整写法（三层解析，按模型3/4/5个各配各的）
#   2026-09-23 - 小欧 - LLM补充采样参数：新增顶层 llm 域（llm.sampling 5键 + llm.context_length_default）
#   2026-09-23 - 小欧 - trim/compaction配置化：tuning组 Agent 循环参数后加 trim 3键/compaction 4键两独立分块；删 tuning.agent.default_max_steps 死键
#   2026-09-23 - 小欧 - 禁止backward还旧账：删 tuning.llm.temperature/max_tokens（已迁顶层 llm.sampling）+ 顶层 agent.max_rounds（已迁 tuning.trim.max_rounds）旧键残留
#   2026-09-23 - 小欧 - 设置页「+添加参数」写入样子打样：zhipuai 段 model_params 补预设新键缀尾（temperature/top_p）+ 自定义键注释样例 + model_meta.range 捎带完整写法
#   2026-09-23 - 小欧 - 连接相关注释重写: provider timeout/max_retries 补优先级注释(高于tuning.llm_net/stream_max_retries) + tuning llm 3键/concurrency 2键/heartbeat/cors 全部改为「阶段+后果+分工」语义对齐 settings_registry notice - 小欧-2026-09-23
#   2026-09-23 - 小欧 - 调优组剩余注释全量重写: llm 2键/trim 3键/compaction 4键/stream_task 3键/hitl 4键/content 3键 全部对齐 settings_registry notice 同口径「管什么+触发时机+后果+分工」 - 小欧-2026-09-23
#   2026-09-23 - 小欧 - 调优组注释去开发术语: 删 SSE/HITL/bypass/CORS/Origin/chunk/FC/C4/TTL/信号量/request body/ConnectTimeout 等代码黑话，全部改纯用户语言，与 registry notice 同步 - 小欧-2026-09-23
#   2026-09-24 21:36:38 - 小欧 - 组名改 tuning.stream_task→tuning.live_front(新名更准确，原名与 tuning.llm.stream_* 易混且非 LLM body 流式)；块下 4 键路径/值/注释措辞不变，仅块名改 — 小欧-2026-09-24
#   2026-10-18 小欧 - security 段按子命名空间重组:
#     system.confirm_dangerous_ops            保存设置的二次确认(仅 UX, 与后端拦截无关)
#     hitl.enabled                            是否走人工确认链路(危险防护不受其影响)
#     hitl.auto_confirm_delay / .timeout      自动确认倒计时秒数 / 人工确认最长等待秒数
#     hitl.shell_readonly_prefixes            只读免确认白名单(留空=用内置名单)
#     trust.ttl_days                          会话信任天数
#     原先 hitl_enabled / confirmDangerousOps / hitl_timeout 平铺写法作废, 读取端已全部改嵌套取值, 不保留旧键。
#   2026-10-18 小欧 - 补 hitl.shell_readonly_prefixes: 原为代码内硬编码, 收紧须发版; 留空即回退内置名单。
#   2026-10-25 小欧 - tuning.trim 3 键→5 键: 加 keep_recent_rounds=5(裁剪时最近 N 个 FC 工具步不裁, 5-20)、
#     tools_token_reserve=30000(tools schema 输入 token 预留, 防裁完仍超窗 400); 与 settings_registry 同批注册。
#   2026-11-01 小欧 - 键名统一: ai.{p}.model_params/model_meta 内的 context_limit → context_length、
#     llm.context_limit_default → llm.context_length_default（与运行时真源同名，旧名作废不保留别名）— 小欧-2026-11-01
#   2026-10-25 23:09 小欧 - tuning.trim.trigger_ratio 0.75→0.9: 触发基准由 context_limit 改可用内容预算(window-compaction_buffer-tools_token_reserve), 与裁剪预算同源单口径; 与 settings_registry 同批改。
#   2026-11-01 小欧 - ai 域新增 kilo Provider 块: 免费网关(实测 /models 拉 384 模型与 :free/0 价调用均免
#     key, 付费需自填 key); 与真实 config.yaml 同步接入 — 小欧-2026-11-01
#   2026-11-01 09:25 小欧 - kilo 块补 5 个 free 模型 + 全量 model_meta(镜像真配置模型库保存实况:
#     cohere/north-mini-code:free、kilo-auto/free、nvidia/nemotron-3.5-super-vl:free、
#     openrouter/free、reflection/beam-free) — 小欧-2026-11-01
#   2026-11-08 小欧 - ai.agnes/ai.sensenova 补双维度 model_meta(能力字段统一为 input/output_modalities;
#     agnes 三个文本模型实测支持看图, 与真实 config.yaml 同构) — 小欧-2026-11-08
#
#
# 严禁事项 — 小欧 2026-09-21
#   禁止新增任何 openai / gpt 相关 provider 或模型（如 openai、gpt-4、gpt-3.5）
#   禁止复制网上模板带入 openai/gpt 垃圾配置（占位 api_key=sk-new-key 之类一律不准出现）
#     命令安全由 path_safe_check/tools/security 代码内实现（路径校验才是关键）

ai:
  # 顶层配置（全局）— 唯一源 ai.model_ref（单源收敛，删扁平 provider/model）
  # 2026-10-11 小欧 - provider 块与 models 列表按运行配置 1:1 镜像（键名大小写原样：
  #   ZenFree/DeepSeek/Z_AI/Discoversh；api_key 一律占位符，真 key 只进 config/config.yaml；
  #   timeout/max_retries 取运行值原样；空 models 表示尚未拉取，配好 key 后到模型库拉取）。
  model_ref: {provider: agnes, model: agnes-3.0-flash}

  # Provider配置（多个）
  # timeout/max_retries 优先级高于全局 tuning.llm_net.read_timeout / tuning.llm.stream_max_retries — 小欧-2026-09-23
  agnes:
    api_base: https://api.agnes-ai.cn/v1
    api_key: sk-xxx...
    models:
      - agnes-2.5-flash
      - agnes-2.5-pro
      - agnes-3.0-flash
      - agnes-image-2.1-flash
      - agnes-video-2.5
      - agnes-video-2.5-flash
    timeout: 120
    max_retries: 3
    # 双维度能力标注（与真实 config.yaml 同构；api_key 占位不落真 key）
    model_meta:
      agnes-2.5-flash:
        input_modalities: [text, image]      # 看图
        output_modalities: [text]
      agnes-2.5-pro:
        input_modalities: [text, image]      # 看图（实测 image_tokens 计入）
        output_modalities: [text]
      agnes-3.0-flash:
        input_modalities: [text, image]      # 看图
        output_modalities: [text]
      agnes-image-2.1-flash:
        input_modalities: [text]             # 生图（不看图）
        output_modalities: [image]
      agnes-image-2.5-flash:
        input_modalities: [text]             # 生图（不看图）
        output_modalities: [image]
      agnes-video-2.5:
        input_modalities: [text]             # 生视频
        output_modalities: [video]
      agnes-video-2.5-flash:
        input_modalities: [text]             # 生视频
        output_modalities: [video]

  sensenova:
    api_base: https://token.sensenova.cn/v1
    api_key: sk-xxx...
    models:
      - deepseek-flash
      - deepseek-v4-flash
      - glm-5.2
      - glm-5.3
      - kimi-k3
      - sensenova-6.8-flash
      - sensenova-6.8-flash-lite
    timeout: 200
    max_retries: 3
    # 双维度能力标注（与真实 config 同构）：input=看图，output=生成产出
    model_meta:
      deepseek-flash:
        input_modalities: [text]
        output_modalities: [text]
      deepseek-v4-flash:
        input_modalities: [text]
        output_modalities: [text]
      glm-5.2:
        input_modalities: [text]
        output_modalities: [text]
      glm-5.3:
        input_modalities: [text]
        output_modalities: [text]
      kimi-k3:
        input_modalities: [text]
        output_modalities: [text]
      sensenova-6.8-flash:
        input_modalities: [text, image]        # 看图
        output_modalities: [text]
      sensenova-6.8-flash-lite:
        input_modalities: [text, image]        # 看图
        output_modalities: [text]

  ZenFree:
    api_base: https://opencode.ai/zen/v1
    api_key: public
    models:
      - big-pickle
      - longcat-2.5-preview-free
      - mimo-v2.6-flash-free
      - muse-spark-1.2-contributor-free
      - muse-spark-1.3-contributor-free
      - space-bunny-free
      - step-5-preview-free
    timeout: 151
    max_retries: 4

  qiniu:
    api_base: https://api.qnaigc.com/v1
    api_key: sk-xxx...
    models:
      - moonshotai/kimi-k3-free
      - nvidia/nemotron-3-ultra-550b-a55b0-free
      - qiniu/conatus-free
      - z-ai/glm-4.5-air-free
    timeout: 90
    max_retries: 3
    model_meta:
      moonshotai/kimi-k3-free:
        context_length: 1048576
        input_modalities: []
        output_modalities: []
        supported_parameters: []
        supported_features: []
      nvidia/nemotron-3-ultra-550b-a55b0-free:
        context_length: 1000000
        input_modalities: []
        output_modalities: []
        supported_parameters: []
        supported_features: []
      qiniu/conatus-free:
        context_length: 1000000
        input_modalities: []
        output_modalities: []
        supported_parameters: []
        supported_features: []
      z-ai/glm-4.5-air-free:
        context_length: 0
        input_modalities: []
        output_modalities: []
        supported_parameters: []
        supported_features: []

  zhipuai:
    api_base: https://open.bigmodel.cn/api/paas/v4/
    api_key: sk-xxx...
    models:
      - glm-4.5
      - glm-4.5-air
      - glm-5.3
    timeout: 90
    max_retries: 3

  Discoversh:
    api_base: https://discovery-api.intern-ai.org.cn/v1
    api_key: sk-xxx...
    models:
      - Agents-A1
      - Atria-Dawn-Preview
    timeout: 120
    max_retries: 3

  openrouter:
    api_base: https://openrouter.ai/api/v1
    api_key: sk-xxx...
    models: []  # 尚未拉取：配好 key 后到模型库「获取模型列表」
    timeout: 60
    max_retries: 3

  amdapi:
    api_base: https://developer.amd.com.cn/radeon/api/v1
    api_key: sk-xxx...
    models: []  # 尚未拉取：配好 key 后到模型库「获取模型列表」
    timeout: 60
    max_retries: 3

  longcat:
    api_base: https://api.longcat.chat/openai/v1
    api_key: sk-xxx...
    models:
      - LongCat-2.0
      - LongCat-2.5-Preview
    timeout: 60
    max_retries: 3

  zenmux:
    api_base: https://zenmux.ai/api/v1
    api_key: sk-xxx...
    models:
      - atria-asi/atria-dawn-preview
      - dots-studio/dots3-note-prev
      - z-ai/glm-4.7-flash-free
    timeout: 60
    max_retries: 3
  # 模型参数当前值（运行时透传 extra_body/context_length）：写法是在对应模型下挂 model_params，
  #   key=参数名，value=当前值（字符串保持字符串，如 reasoning_effort: medium）；
  #   设置页「+ 添加参数」勾选预设后保存即按此形状写入 — 小欧-2026-10-11
  #   摘除契约：value 显式 null/false = 从请求体移除该默认键（严格校验上游适配，RFC 7396 同语义）— 小欧-2026-11-10

  Z_AI:
    api_base: https://api.z.ai/api/paas/v4
    api_key: sk-xxx...
    models:
      - glm-5.3-flash
    timeout: 60
    max_retries: 3

  DeepSeek:
    api_base: https://api.deepseek.com/v1
    api_key: sk-xxx...
    models:
      - deepseek-flash
      - deepseek-v4-pro
    timeout: 60
    max_retries: 3

  moonshot:
    api_base: https://api.moonshot.cn/v1
    api_key: sk-xxx...
    models:
      - kimi-k2.6
      - kimi-k3
    timeout: 60
    max_retries: 3

  minimax:
    api_base: https://api.minimax.cn/v1
    api_key: sk-xxx...
    models:
      - MiniMax-M2.7
      - MiniMax-M3
    timeout: 60
    max_retries: 3

  # kilo.ai 免费网关 — 小欧-2026-11-01：/models 拉取与 :free/0 价模型调用均免 key（实测 384 模型），
  # 付费模型调用才需填 api_key；api_key 留空即免 key 使用（免费面已可用），models 空表=到模型库拉取勾选。
  # 以下 models/model_meta 镜像自真实 config.yaml（2026-11-01 模型库保存实况）
  kilo:
    api_base: https://ai-gateway.kilo.ai/api/v1
    api_key: ''
    timeout: 120
    max_retries: 3
    models:
      - google/lyria-3-clip-preview
      - google/lyria-3-pro-preview
      - kilo-auto/free
      - nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
      - openrouter/free
    model_meta:
      google/lyria-3-clip-preview:
        context_length: 1048576
        max_output_length: 65536
        input_modalities:
          - text
          - image
        output_modalities:
          - text
          - audio
        supported_parameters:
          - max_tokens
          - response_format
          - seed
          - temperature
          - top_p
        supported_features: []
      google/lyria-3-pro-preview:
        context_length: 1048576
        max_output_length: 65536
        input_modalities:
          - text
          - image
        output_modalities:
          - text
          - audio
        supported_parameters:
          - max_tokens
          - response_format
          - seed
          - temperature
          - top_p
        supported_features: []
      kilo-auto/free:
        context_length: 256000
        max_output_length: 32768
        input_modalities:
          - text
        output_modalities:
          - text
        supported_parameters:
          - max_tokens
          - temperature
          - tools
          - reasoning
          - include_reasoning
        supported_features: []
      nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free:
        context_length: 256000
        max_output_length: 65536
        input_modalities:
          - text
          - audio
          - image
          - video
        output_modalities:
          - text
        supported_parameters:
          - include_reasoning
          - max_tokens
          - reasoning
          - seed
          - temperature
          - tool_choice
          - tools
          - top_p
        supported_features: []
      openrouter/free:
        context_length: 200000
        input_modalities:
          - text
          - image
        output_modalities:
          - text
        supported_parameters:
          - frequency_penalty
          - include_reasoning
          - logprobs
          - max_completion_tokens
          - max_tokens
          - min_p
          - presence_penalty
          - reasoning
          - reasoning_effort
          - repetition_penalty
          - response_format
          - seed
          - stop
          - structured_outputs
          - temperature
          - tool_choice
          - tools
          - top_k
          - top_logprobs
          - top_p
        supported_features: []

  # opencli 免费车道网关（opencode2api + WARP 出口池），本地 127.0.0.1:8080，0 key 匿名车道
  opencli:
    name: opencli
    label: Opencode-Cli
    api_base: http://127.0.0.1:8080/v1
    api_key: 97f2971ba14456bb0e5daacb42ee238584aa0a0d903f5937bed09c573b1fd6fe
    timeout: 300
    max_retries: 3
    # model_params 键值显式null=请求体摘除该默认键(beam-free上游严格校验拒收chat_template_kwargs) — 小欧 2026-11-10
    model_params:
      beam-free:
        chat_template_kwargs: null
    models:
      - beam-free
      - big-pickle
      - crouton-alpha-free
      - deepseek-v4.1-flash-free
      - glm-5.3-flash-free
      - inkling-2-small-free
      - mimo-v2.6-flash-free
    model_meta:
      beam-free:
        context_length: 1048576
        max_output_length: 131072
        input_modalities:
          - text
        output_modalities:
          - text
        supported_features:
          - reasoning
          - tools
        supported_parameters: []
      big-pickle:
        context_length: 200000
        max_output_length: 32000
        input_modalities:
          - text
        output_modalities:
          - text
        supported_features:
          - reasoning
          - tools
        supported_parameters: []
      crouton-alpha-free:
        context_length: 1048576
        max_output_length: 270000
        input_modalities:
          - text
          - image
          - video
          - file
        output_modalities:
          - text
        supported_features:
          - reasoning
          - tools
        supported_parameters: []
      deepseek-v4.1-flash-free:
        context_length: 200000
        max_output_length: 32000
        input_modalities:
          - text
          - image
        output_modalities:
          - text
        supported_features:
          - reasoning
          - tools
        supported_parameters: []
      glm-5.3-flash-free:
        context_length: 200000
        max_output_length: 32000
        input_modalities:
          - text
          - image
          - video
        output_modalities:
          - text
        supported_features:
          - reasoning
          - tools
        supported_parameters: []
      inkling-2-small-free:
        context_length: 1048576
