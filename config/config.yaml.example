# OmniAgentAs-desk 配置文件模板
# 使用说明：
# 1. 复制此文件为 config.yaml
# 2. 填入您的API密钥
# 3.  config.yaml 已被Git忽略，不会提交到仓库

ai:
  # ✅ 顶层配置（全局）
  model: kimi-k2.5-free
  provider: opencode  # ✅ 当前Provider

  # ✅ Provider配置（多个）
  opencode:
    api_base: https://opencode.ai/zen/v1
    api_key: sk_xxx...
    models:
      - minimax-m2.5-free
      - kimi-k2.5-free
    timeout: 120

  longcat:
    api_base: https://api.longcat.chat/openai/v1
    api_key: ak_xxx...
    models:
      - LongCat-Flash-Thinking
      - LongCat-Flash-Thinking
    timeout: 120

  zhipuai:
    api_base: https://test.com
    api_key: test123
    max_retries: 3
    models:
      - glm-4.7-flash
      - cogview-3-flash
    timeout: 90

# 应用配置
app:
  debug: true
  language: zh-CN
  max_context_tokens: 200000
  max_history_length: 10
  max_rounds: 100
  max_steps: 10000
  project_root: ""  # 项目根=tool工作区; 未配置(空)时兜底=用户主目录 — 小欧 2026-08-10 ①
  # 授权目录列表(可多个): tool 在项目根之外额外授权访问的工作目录。
  # 格式: YAML 列表, 每行一个绝对路径, 以 "- " 开头(不是逗号/分号分隔字符串), 例如:
  #   allowed_dirs:
  #     - D:\工作目录A
  #     - D:\工作目录B
  # 注意: 项目根天然在授权内, 无需重复列入; 指向代码库根或其父/子级 → 加载即拒(与⑦tool禁区冲突) — 小欧 2026-08-10 ⑩
  allowed_dirs: []
  theme: light

# 安全配置
# 2026-09-03 小欧: 新增 auto_confirm_delay(bypass自动确认S1窗口,默认10) 与 hitl_timeout(真HITL确认超时,默认120) 两个可配置计时键
security:
  auto_confirm_delay: 10
  hitl_timeout: 120
  commandBlacklist: ''
  commandWhitelist: ''
  confirmDangerousOps: true
  contentFilterEnabled: true
  contentFilterLevel: medium
  enabled: false
  maxFileSize: 100
  strict_mode: false
  whitelistEnabled: false

# 【新增】沙箱预检配置节（与 config.yaml 同步, 2026-08-25 小欧）
sandbox:
  enabled: true                    # 总开关(逃生门): false=完全关闭预检, 行为与实施前一致
  backend: "job_object"            # 后端选择键(预留扩展位): 当前唯一实现 job_object
  max_concurrent_sandboxes: 3      # 并发预检信号量上限(防N×内存上限叠加)
  max_workspace_mb: 500            # 工作区大小上限; 超限拒绝预检转HITL强确认
  max_shadow_mb: 100               # 影子副本单文件上限; 超限跳过副本仅统计影响面
  process_memory_limit_mb: 2048    # Job Object 进程树内存上限(误杀时调大此值)
  default_timeout_sec: 60          # 预检默认超时(LLM未声明timeout时生效)
  max_timeout_sec: 300             # 预检硬上限5分钟; 声明超上限直接转HITL强确认

# 文件操作配置
file_operations:
  # 工作目录（文件操作的根目录）
  workspace_dir: "./workspace"
  # 是否启用安全模式（禁止删除操作）
  safe_mode: true
  # 最大文件大小（MB）
  max_file_size: 10

# 日志配置
logging:
  level: INFO  # DEBUG, INFO, WARNING, ERROR
  file: logs/app.log
  max_size: 10MB
  backup_count: 5
